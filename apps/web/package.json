{
  "name": "@furniconfig/web",
  "version": "0.1.0",
  "private": true,
  "description": "Visualizador 3D interactivo de clósets modulares (React + Vite + React Three Fiber).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:visual": "node tests/visual/visual-check.mjs"
  },
  "dependencies": {
    "@furniconfig/geometry-core": "*",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.0",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

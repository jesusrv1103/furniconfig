{
  "name": "@furniconfig/geometry-core",
  "version": "0.1.0",
  "private": true,
  "description": "Motor geométrico paramétrico puro de FurniConfig. Unidad interna: milímetros. Sin dependencias runtime.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

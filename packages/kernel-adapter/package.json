{
  "name": "@furniconfig/kernel-adapter",
  "version": "0.0.0",
  "private": true,
  "description": "EXPERIMENTAL (FASE-4B-0): adaptador mínimo GeometryKernel sobre manifold-3d para la prueba de viabilidad. No integrado en el visor principal.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "experiment": "node experiments/run-all.mjs",
    "clean": "rm -rf experiments/dist"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "manifold-3d": "3.5.4"
  }
}
